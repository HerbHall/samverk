# Samverk AI Provider Registry
# Copy to providers.yaml and adjust as needed.
# API keys are read from environment variables — never put actual keys here.

providers:
  claude-haiku:
    type: claude-cli
    default_model: claude-haiku-4-5-20251001

  claude-sonnet:
    type: claude-cli
    default_model: claude-sonnet-4-6
    timeout_seconds: 600

  claude-opus:
    type: claude-cli
    default_model: claude-opus-4-6
    timeout_seconds: 900

  # API-based providers (require env var with API key)
  # claude-api:
  #   type: claude
  #   api_key_env: ANTHROPIC_API_KEY
  #   default_model: claude-sonnet-4-6

  # openai:
  #   type: openai
  #   api_key_env: OPENAI_API_KEY
  #   default_model: gpt-4o

  ollama-coder:
    type: ollama
    base_url: http://localhost:11434
    default_model: qwen2.5-coder:7b
    timeout_seconds: 120

# Routing chains: tried in order, first healthy provider wins.
routing:
  triage:   [claude-haiku, claude-sonnet]
  default:  [claude-sonnet]
  complex:  [claude-opus, claude-sonnet]
  local:    [ollama-coder, claude-sonnet]
  frontend: [claude-sonnet]
