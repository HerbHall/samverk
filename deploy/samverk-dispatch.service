[Unit]
Description=Samverk Dispatcher (Issue Watcher + Agent Router)
Documentation=https://github.com/herbhall/samverk
After=network-online.target samverk-serve.service
Wants=network-online.target

[Service]
Type=simple
User=samverk
Group=samverk
WorkingDirectory=/var/lib/samverk
# Brief delay so samverk-serve can open/migrate the SQLite database first.
# Type=simple means systemd considers serve "started" immediately after fork,
# before it actually finishes store.New(). Without this, both processes race
# to open the same .db file simultaneously.
ExecStartPre=/bin/sleep 2
ExecStart=/usr/local/bin/samverk dispatch \
  --db /var/lib/samverk/.samverk/samverk.db \
  --providers-config /var/lib/samverk/.samverk/providers.yaml \
  --poll-interval 30 \
  --workers 3
EnvironmentFile=/var/lib/samverk/.samverk/samverk.env
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=samverk-dispatch

# Graceful shutdown: only signal the main PID so child processes (claude-cli)
# are left running and the Go drain logic (pool.Shutdown) can finish them.
KillMode=process
# 30 minutes — matches opus provider timeout (900s) with headroom for
# session teardown and issue updates.
TimeoutStopSec=1800

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/samverk
PrivateTmp=true

[Install]
WantedBy=multi-user.target
