# Samverk Environment Variables
# Copy this file to /var/lib/samverk/.samverk/samverk.env
# and fill in the values.

# GitHub Personal Access Token (required for MCP + dispatch)
# Needs: repo scope (issues, comments, labels, file read)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub repository defaults (can also use --owner/--repo flags)
SAMVERK_GITHUB_OWNER=herbhall
SAMVERK_GITHUB_REPO=samverk

# MCP Bearer token auth (simple single-token mode)
# Generate with: openssl rand -hex 32
SAMVERK_AUTH_TOKEN=

# Anthropic Claude API key (for claude provider)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# OpenAI API key (for openai provider, optional)
OPENAI_API_KEY=sk-xxxxxxxxxxxx
