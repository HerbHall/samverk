#!/usr/bin/env bash
# Pre-push hook: runs the same checks as CI before allowing a push.
# Install: make hooks (or: cp scripts/pre-push .git/hooks/pre-push)
set -euo pipefail

echo "==> pre-push: running CI checks..."

# Read tool versions from tools.json (single source of truth)
GOLANGCI_VERSION=$(grep '"golangci-lint"' tools.json 2>/dev/null | sed 's/.*: *"\(.*\)".*/\1/' || echo "v2.10.1")

echo "--- go build"
go build ./...

echo "--- go test"
go test ./...

echo "--- golangci-lint"
go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${GOLANGCI_VERSION} run ./...

echo "--- markdownlint"
npx --yes markdownlint-cli2 "**/*.md" "#node_modules" "#web/node_modules" "#CHANGELOG.md" "#.samverk" "#.claude" "#**/.claude"

echo "--- frontend typecheck"
(cd web && npx tsc --noEmit)

echo "--- frontend lint"
(cd web && pnpm lint)

echo "--- frontend tests"
(cd web && pnpm test:ci)

echo "==> pre-push: all checks passed"
